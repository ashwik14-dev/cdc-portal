# Server port
PORT=5000

# MongoDB connection string
MONGO_URI=mongodb://127.0.0.1:27017/cdc_portal

# JWT secret - use a long random string in production
JWT_SECRET=change_this_to_a_long_random_secret_string
JWT_EXPIRES_IN=1d

# Frontend URL for CORS
CLIENT_URL=http://localhost:5173

# Cookie security
# COOKIE_SECURE=true and COOKIE_SAME_SITE=none are required when the frontend and
# API are on different sites (e.g. Vercel + Render) and you rely on the cookie.
# The frontend also stores a Bearer token, so login works even without the cookie.
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Admin account created by `npm run seed`
SEED_ADMIN_EMAIL=admin@cdc.ac.in
SEED_ADMIN_PASSWORD=Admin@123

# Also seed the demo faculty + student accounts documented in the README
# (set to false to create only the admin account)
SEED_DEMO_ACCOUNTS=true

# Optional: absolute API base URL.
# Leave empty for local development - the Vite dev server proxies /api to
# http://localhost:5000, so requests stay same-origin.
# Set this to your deployed API when the frontend is hosted separately:
# VITE_API_URL=https://cdc-portal-api.onrender.com/api
VITE_API_URL=

# Optional: fixed public base URL used to build the student QR verification links.
# Leave empty/undefined to auto-detect from the browser (window.location.origin),
# which works when the app is opened on the LAN IP (e.g. http://192.168.1.5:5173).
# Set this to a deployed domain so QR codes work from any phone:
# VITE_PUBLIC_ORIGIN=https://cdc.example.com
VITE_PUBLIC_ORIGIN=
